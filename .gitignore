# Create .gitignore with everything you need
@"
# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Cache
.cache/
.pytest_cache/
*.cache

# Environment variables
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Model artifacts
*.pkl
*.joblib
*.pt
*.pth

# Data cache
data/
*.csv
"@ | Out-File -FilePath .gitignore -Encoding utf8

# Auto-generated review files
review.md
review_history.md
spec.md
.codex_prompt.txt

# Local hook secrets (Anthropic API key for the Stop-hook reviewer)
.claude/hooks/.env